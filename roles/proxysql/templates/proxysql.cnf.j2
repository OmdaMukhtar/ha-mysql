########################################################################################
# ProxySQL Configuration
# Managed by Ansible — DO NOT EDIT MANUALLY
########################################################################################

datadir = "/var/lib/proxysql"
errorlog = "/var/lib/proxysql/proxysql.log"

admin_variables =
{
    admin_credentials     = "{{ proxysql_admin_user }}:{{ proxysql_admin_password }}"
    mysql_ifaces          = "0.0.0.0:{{ proxysql_admin_port }}"
    refresh_interval      = 2000
    web_enabled           = false
}

mysql_variables =
{
    threads                 = 4
    max_connections         = 2048
    default_query_delay     = 0
    default_query_timeout   = 36000000
    have_compress           = true
    poll_timeout            = 2000
    interfaces              = "0.0.0.0:{{ proxysql_mysql_port }}"
    default_schema          = "information_schema"
    stacksize               = 1048576
    server_version          = "8.0.32"
    connect_timeout_server  = 3000
    monitor_username        = "{{ proxysql_monitor_user }}"
    monitor_password        = "{{ proxysql_monitor_password }}"
    monitor_history         = 600000
    monitor_connect_interval = 60000
    monitor_ping_interval   = 10000
    monitor_read_only_interval  = 1500
    monitor_read_only_timeout   = 500
    ping_interval_server_msec   = 120000
    ping_timeout_server         = 500
    commands_stats          = true
    sessions_sort           = true
    connect_retries_on_failure  = 10
}

# ─── MySQL Servers ────────────────────────────────────────────────
mysql_servers =
(
    {
        address     = "{{ mysql_primary_host }}"
        port        = {{ mysql_port }}
        hostgroup   = {{ proxysql_writer_hostgroup }}
        status      = "ONLINE"
        weight      = 1000
        compression = 0
        comment     = "primary-writer"
    },
{% for host in groups['mysql_replicas'] %}
    {
        address     = "{{ hostvars[host]['ansible_host'] }}"
        port        = {{ mysql_port }}
        hostgroup   = {{ proxysql_reader_hostgroup }}
        status      = "ONLINE"
        weight      = 100
        compression = 0
        comment     = "replica-reader-{{ loop.index }}"
    }{% if not loop.last %},{% endif %}

{% endfor %}
)

# ─── MySQL Users ─────────────────────────────────────────────────
mysql_users =
(
    {
        username            = "{{ mysql_app_user }}"
        password            = "{{ mysql_app_password }}"
        default_hostgroup   = {{ proxysql_writer_hostgroup }}
        active              = 1
        transaction_persistent = 1
    }
)

# ─── Query Rules ──────────────────────────────────────────────────
# Rule 10: DML → writer hostgroup (primary)
# Rule 20: SELECT → reader hostgroup (replicas)
mysql_query_rules =
(
    {
        rule_id             = 10
        active              = 1
        match_pattern       = "^(INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|TRUNCATE)"
        destination_hostgroup = {{ proxysql_writer_hostgroup }}
        apply               = 1
        comment             = "writes-to-primary"
    },
    {
        rule_id             = 20
        active              = 1
        match_pattern       = "^SELECT"
        destination_hostgroup = {{ proxysql_reader_hostgroup }}
        apply               = 1
        comment             = "reads-to-replicas"
    }
)

# ─── Replication Hostgroups ───────────────────────────────────────
mysql_replication_hostgroups =
(
    {
        writer_hostgroup = {{ proxysql_writer_hostgroup }}
        reader_hostgroup = {{ proxysql_reader_hostgroup }}
        comment          = "MySQL Primary-Replica HA"
    }
)
